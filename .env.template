# Duplicate this file in your local repo with filename `.env`. It will be ignored by git, but loaded
# by Gradle via a dotenv Gradle plugin and passed to the app to use as instance configs.

# Note that any values provided in this template will never be read - they are there to provide
# example values only. Any uncommented vars in this file *must* be set in a local .env file.

# Required variables - must be set in .env, build will throw if missing.
APP_MUSICLUB_ENVIRONMENT=Development
APP_MUSICLUB_DB_HOST=localhost
APP_MUSICLUB_DB_SCHEMA=musiclub
APP_MUSICLUB_DB_USER=musiclub
APP_MUSICLUB_DB_PASSWORD=musiclub

# Additional DB options
#APP_MUSICLUB_USE_H2=true
#APP_MUSICLUB_DB_CREATE=update

# OAuth provider - set to AUTH_ZERO (default), ENTRA_ID, or NONE (local username/password login)
#APP_MUSICLUB_OAUTH_PROVIDER=AUTH_ZERO

# Bootstrap admin
# The _USER var can be set on its own to grant an OAuth-sourced user admin rights in local
# development. This is supported by Hoist Core `DefaultRoleService`.
#APP_MUSICLUB_BOOTSTRAP_ADMIN_USER=

# If the _PASSWORD var is also set, Bootstrap will create a password-enabled user in its user
# database that can be used when Auth0 is not available.
# Pair with `APP_MUSICLUB_OAUTH_PROVIDER=NONE` to disable the OAuth flow entirely and present a
# form-based login, useful when testing the client when offline or on a private IP address via
# `yarn startWithHoistAndIp` for on-device mobile testing.
#APP_MUSICLUB_BOOTSTRAP_ADMIN_PASSWORD=

# Email support
#APP_MUSICLUB_SMTP_HOST=
#APP_MUSICLUB_SMTP_USER=
#APP_MUSICLUB_SMTP_PASSWORD=
